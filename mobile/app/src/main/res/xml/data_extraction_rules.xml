<?xml version="1.0" encoding="utf-8"?>
<!-- Финансовые данные и токены не включаются в резервные копии и перенос на другое устройство -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
