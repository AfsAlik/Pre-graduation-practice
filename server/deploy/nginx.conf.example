# Пример настройки обратного прокси с сертификатом TLS (п. 4.1.2.1 ТЗ: только HTTPS, TLS не ниже 1.2)
server {
    listen 80;
    server_name api.example.ru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name api.example.ru;

    ssl_certificate     /etc/letsencrypt/live/api.example.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.ru/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Метрики доступны только из внутренней сети
    location /metrics { deny all; }
}
