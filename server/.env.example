# Параметры серверной части «Финансового помощника».
# Скопируйте файл в .env и измените значения. Назначение параметров – в README.md.

# --- База данных (используются контейнером PostgreSQL и приложением) ---
POSTGRES_USER=finhelper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finhelper

# --- Общие ---
FH_ENVIRONMENT=prod
FH_SECRET_KEY=replace-with-a-long-random-string
FH_PUBLIC_BASE_URL=http://localhost:8000
FH_PORT=8000
FH_WEB_WORKERS=2
FH_REQUIRE_EMAIL_CONFIRMATION=false

# --- Внешние источники данных: cbr | static, moex | static ---
FH_RATES_PROVIDER=cbr
FH_QUOTES_PROVIDER=moex

# --- Уведомления: log – запись в журнал вместо отправки ---
FH_PUSH_PROVIDER=log
FH_FCM_CREDENTIALS_FILE=
FH_EMAIL_PROVIDER=log
FH_SMTP_HOST=
FH_SMTP_PORT=587
FH_SMTP_USER=
FH_SMTP_PASSWORD=
FH_SMTP_FROM=noreply@finhelper.local

# --- Хранилище файлов: local | s3 ---
FH_STORAGE_PROVIDER=local
FH_S3_ENDPOINT=
FH_S3_BUCKET=finhelper
FH_S3_ACCESS_KEY=
FH_S3_SECRET_KEY=

# --- Мониторинг (профиль monitoring) ---
GRAFANA_PASSWORD=admin
